# quant-swarm configuration
# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the filled copy.
#
# APEX/QA finding: 28 environment variables governed this system's behaviour --
# including the drawdown kill switch and whether real orders are placed -- and
# none of them were documented anywhere. An operator could not tell which knobs
# existed, what the defaults were, or which ones move real money.
#
# Every variable the code reads is listed here. The audit for this file is
# tests/test_env_documentation.py, which fails if the two drift apart.
# ---------------------------------------------------------------------------


# === MODE — decides whether real money moves ===============================
# PAPER    simulated broker, no exchange orders. The safe default.
# TESTNET  Bybit testnet. Real API calls, play money.
# LIVE     REAL ORDERS WITH REAL CAPITAL.
#
# Leaving this unset does NOT default to LIVE. Live trading requires setting it
# explicitly -- activation is a deliberate human action, never a side effect of
# credentials being present.
TRADING_MODE=PAPER

# Legacy switch, still honoured for backward compatibility. TRADING_MODE wins
# where both are set.
# TEST_MODE=true


# === EXCHANGE CREDENTIALS ==================================================
# Required for TESTNET and LIVE. Unused in PAPER.
# Keep these out of source control, CI logs, screenshots and support tickets.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Bybit position mode. 0 = one-way (default). 1 = hedge-buy, 2 = hedge-sell.
# Must match the account's actual setting, or reduce-only exits address the
# wrong side of the book.
BYBIT_POSITION_IDX=0


# === RISK LIMITS — read these before changing anything =====================
# Fraction of peak equity lost before the portfolio commander force-flattens.
MAX_DRAWDOWN_PCT=0.15

# Fraction of equity risked on a single position.
MAX_SINGLE_POSITION_RISK_PCT=0.025

# Below this equity (USDT) the risk vault halts trading rather than sizing down
# into dust.
MIN_REQUIRED_EQUITY=50.0

# Rejects an order whose notional deviates from the intended size by more than
# this fraction. This is the B1 guard: quantisation once inflated a $500 order
# to $6,500, and this is what stops it reaching the exchange.
NOTIONAL_DEVIATION_TOLERANCE=0.25

# Orderbook older than this (seconds) is not tradeable. Applies to entries and,
# since the B19/B20 residual fix, to software exit decisions too.
MAX_ORDERBOOK_AGE_SEC=5.0

# true  -> skip a trade whose size falls below the exchange minimum notional
# false -> round UP to the minimum, which SPENDS MORE THAN INTENDED
# Keep this true unless you specifically want the second behaviour.
SKIP_BELOW_MIN_NOTIONAL=true


# === STRATEGY ==============================================================
TRADING_TIMEFRAME=15
BAR_SERIES_INTERVAL=5

# Paper-mode starting equity. No effect on TESTNET or LIVE.
PAPER_STARTING_BALANCE=1000.0

# Online micro-horizon learning.
ENABLE_MICRO_HORIZON_LEARNING=true
MICRO_HORIZON_SEC=60.0

# Freeze RLS weights: run the fitted model without adapting. Use for a genuine
# out-of-sample evaluation, where continued learning would mean the test period
# is fitting on itself.
FREEZE_RLS_WEIGHTS=false

# Delta-neutral module. Off unless deliberately enabled.
ENABLE_DELTA_NEUTRAL=false

# After-cost edge gate. Groups entries by model conviction and tracks the
# realised NET return (after fees and funding) of every settled trade in each
# group. A group must earn its way past a pessimistic prior (-15 bps, i.e.
# "costs paid, no edge") before it counts as profitable.
#   off      never blocks
#   shadow   never blocks; logs and counts every entry it WOULD block (default)
#   enforce  blocks losing groups once EDGE_GATE_MIN_TRADES trades have settled
# If no group is profitable, enforce mode stops trading altogether. That is the
# gate working, not failing.
EDGE_GATE_MODE=shadow
EDGE_GATE_MIN_TRADES=100


# === V12 DECISION PIPELINE AND KILL SWITCHES ===============================
# enforce  an entry needs a V12 TRADE decision (expected value after ALL costs,
#          multi-timeframe agreement, regime, spread, measured edge) AND a pass
#          from the guardian. V12 sets the stop, target and size (size can only
#          go DOWN from the legacy figure). Default.
# shadow   V12 decides and journals everything but blocks nothing (A/B).
# off      V12 not started.
V12_MODE=enforce

# In LIVE mode the guardian refuses every new entry until an APPROVED
# paper-trading promotion record exists (scripts/evaluate_promotion.py writes
# it only on --approve --operator NAME after 100+ profitable paper trades).
PROMOTION_FILE=reports/promotion/latest.json
# Escape hatch that skips the promotion requirement. NOT recommended: it means
# real capital on a strategy that has not shown an edge in paper trading.
ALLOW_UNPROMOTED_LIVE=false

# Kill-switch hierarchy (fractions of equity).
#   L3: loss since the start of the UTC day at which new entries stop
MAX_DAILY_LOSS_PCT=0.03
#   L4: drawdown from peak at which new entries pause (the 15% force-flatten is
#       MAX_DRAWDOWN_PCT above)
DRAWDOWN_PAUSE_PCT=0.08
# Same-direction notional allowed in one correlated cluster (e.g. all memes long)
MAX_CLUSTER_EXPOSURE_PCT=0.50
# Total open notional across all positions
MAX_GROSS_EXPOSURE_PCT=1.00
# Largest single position notional V12 will size, before the risk cap
V12_MAX_NOTIONAL_PCT=0.25

# Exit policy. Leave blank to use the built-in runner policy. Point it at a
# candidate file ONLY after reviewing and approving it with
# scripts/approve_candidate.py -- unapproved files are ignored.
EXIT_POLICY_FILE=

# Seconds between V12 strategy-health reports to Telegram.
V12_REPORT_INTERVAL_SEC=3600


# === PERSISTENCE ===========================================================
# Where the SQLite ledger and model state live. On an ephemeral container this
# MUST point at a mounted volume, or model state and trade history are lost on
# every restart.
PERSISTENT_STORAGE_PATH=.

# Optional cloud ledger (PostgREST). Leave blank to run SQLite-only.
SUPABASE_URL=
SUPABASE_KEY=


# === OPERATIONS ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Health server. It binds 0.0.0.0, so its routes are reachable from the public
# internet on a hosted deployment.
ENABLE_KEEP_ALIVE=false
PORT=8080

# Shared secret for /metrics and the metrics block of /health. Those expose the
# account's equity and wallet balance. With this UNSET the detailed routes are
# CLOSED -- forgetting to configure it exposes nothing. Plain /health liveness
# stays open so platform health checks keep working.
HEALTH_TOKEN=


# === RESEARCH (offline only; never touches an account) =====================
KLINE_CACHE_DIR=./data/klines
EXPERIMENT_DIR=./reports/experiments
